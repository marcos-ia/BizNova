// FILTROS TIENDA (solo aplica si la página tiene la tienda)
let activeCat=null;
function applyFilters(){
  const shopGrid=document.getElementById('shopGrid');
  if(!shopGrid)return;
  const cats=['vinos','champagne','whisky','cognac','vodka','regalos'].filter(c=>document.getElementById('f-'+c)?.checked);
  const mn=parseFloat(document.getElementById('priceMin')?.value)||0;
  const mx=parseFloat(document.getElementById('priceMax')?.value)||Infinity;
  const isNew=document.getElementById('f-new')?.checked;
  const isPrem=document.getElementById('f-premium')?.checked;
  const isReg=document.getElementById('f-regalos2')?.checked;
  const sort=document.getElementById('shopSort')?.value||'default';
  let f=[...products];
  if(activeCat)f=f.filter(p=>p.cat===activeCat||p.tags.includes(activeCat));
  if(cats.length)f=f.filter(p=>cats.includes(p.cat)||cats.some(c=>p.tags.includes(c)));
  if(mn>0)f=f.filter(p=>p.price>=mn);
  if(mx<Infinity)f=f.filter(p=>p.price<=mx);
  if(isNew)f=f.filter(p=>p.tags.includes('new'));
  if(isPrem)f=f.filter(p=>p.tags.includes('premium'));
  if(isReg)f=f.filter(p=>p.tags.includes('regalos'));
  if(sort==='price-asc')f.sort((a,b)=>a.price-b.price);
  else if(sort==='price-desc')f.sort((a,b)=>b.price-a.price);
  else if(sort==='name')f.sort((a,b)=>a.name.localeCompare(b.name));
  document.getElementById('shopCount').textContent=`Mostrando ${f.length} producto${f.length!==1?'s':''}`;
  shopGrid.innerHTML=f.length?f.map(cardHTML).join(''):'<p style="grid-column:1/-1;padding:3rem;text-align:center;font-family:\'Cormorant Garamond\',serif;font-size:1.1rem;color:var(--text-mid)">No se encontraron productos con estos filtros.</p>';
}

// Si llegamos a tienda.html con ?cat=vinos desde otra página, aplicamos el filtro automáticamente
if(document.getElementById('shopGrid')){
  const urlCat=new URLSearchParams(location.search).get('cat');
  if(urlCat){
    activeCat=urlCat;
    const checkbox=document.getElementById('f-'+urlCat);
    if(checkbox)checkbox.checked=true;
  }
  applyFilters();
}

// TOAST
function showToast(m){
  const t=document.getElementById('toast');
  if(!t)return;
  t.textContent=m;t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2800);
}

// FORMSPREE (solo si existe el formulario en la página)
const form=document.getElementById('contactForm');
if(form)form.addEventListener('submit',async e=>{
  e.preventDefault();
  const btn=document.getElementById('submitBtn');
  btn.textContent='Enviando…';btn.disabled=true;
  try{
    const r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'Accept':'application/json'}});
    if(r.ok){form.style.display='none';document.getElementById('formSuccess').style.display='block';}
    else{btn.textContent='Error. Inténtelo de nuevo.';btn.disabled=false;}
  }catch{btn.textContent='Error de conexión.';btn.disabled=false;}
});

