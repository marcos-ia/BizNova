// CARRITO
let cart=[];
let curProd=null;
let mQty=1;

function addToCart(id,qty=1){
  const p=products.find(x=>x.id===id);
  if(!p)return;
  const ex=cart.find(x=>x.id===id);
  if(ex)ex.qty+=qty;
  else cart.push({...p,qty});
  updateCart();
  showToast('✓  '+p.name+' añadido');
}
function removeFromCart(id){cart=cart.filter(x=>x.id!==id);updateCart()}
function chgCartQty(id,d){
  const it=cart.find(x=>x.id===id);
  if(!it)return;
  it.qty+=d;
  if(it.qty<=0)removeFromCart(id);
  else updateCart();
}
function updateCart(){
  const total=cart.reduce((s,i)=>s+i.price*i.qty,0);
  const count=cart.reduce((s,i)=>s+i.qty,0);
  document.getElementById('cartCount').textContent=count;
  document.getElementById('cartTotal').textContent=total.toFixed(2).replace('.',',')+'  €';
  const el=document.getElementById('cartBody');
  if(!cart.length){el.innerHTML='<div class="cart-empty"><span class="cart-empty-icon">🛒</span><p class="cart-empty-txt">Tu carrito está vacío</p></div>';return;}
  el.innerHTML=cart.map(i=>`
    <div class="ci-item">
      <img class="ci-img" src="${i.img}" alt="${i.name}" onerror="this.style.opacity='.2'">
      <div>
        <p class="ci-name">${i.name}</p>
        <p class="ci-reg">${i.region}</p>
        <div class="ci-qrow">
          <button class="ci-qbtn" onclick="chgCartQty(${i.id},-1)">−</button>
          <span class="ci-q">${i.qty}</span>
          <button class="ci-qbtn" onclick="chgCartQty(${i.id},1)">+</button>
          <button class="ci-rm" onclick="removeFromCart(${i.id})">✕</button>
        </div>
      </div>
      <span class="ci-price">${(i.price*i.qty).toFixed(2).replace('.',',')} €</span>
    </div>`).join('');
}
function toggleCart(){
  document.getElementById('cartDrw').classList.toggle('open');
  document.getElementById('cartOvl').classList.toggle('open');
}

// PRODUCT MODAL
function openProd(id){
  const p=products.find(x=>x.id===id);
  if(!p)return;
  curProd=p;mQty=1;
  document.getElementById('mqty').textContent=1;
  document.getElementById('pmImg').src=p.img;
  document.getElementById('pmImg').alt=p.name;
  document.getElementById('pmBadge').textContent=p.badge;
  document.getElementById('pmName').textContent=p.name;
  document.getElementById('pmRegion').textContent=p.region;
  document.getElementById('pmPrice').textContent=p.price.toFixed(2).replace('.',',')+' €';
  document.getElementById('pmDesc').textContent=p.desc;
  document.getElementById('pmDets').innerHTML=Object.entries(p.details).map(([k,v])=>`<div class="pm-det"><p class="pm-det-lbl">${k}</p><p class="pm-det-val">${v}</p></div>`).join('');
  document.getElementById('pmOverlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function closePM(e){if(e.target===document.getElementById('pmOverlay'))closePMBtn()}
function closePMBtn(){document.getElementById('pmOverlay').classList.remove('open');document.body.style.overflow=''}
function chgQty(d){mQty=Math.max(1,mQty+d);document.getElementById('mqty').textContent=mQty}
function addFromModal(){if(curProd){addToCart(curProd.id,mQty);closePMBtn()}}

// RENDER CARD
function cardHTML(p){
  return`<div class="product-card">
    <div class="pc-img-wrap" onclick="openProd(${p.id})">
      <img class="pc-img" src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.style.opacity='.15'">
      <div class="pc-badges">
        <span class="badge b-amber">${p.badge}</span>
        ${p.tags.includes('new')?'<span class="badge b-dark">Nuevo</span>':''}
        ${p.tags.includes('premium')?'<span class="badge b-wine">Premium</span>':''}
      </div>
      <button class="pc-quick" onclick="event.stopPropagation();openProd(${p.id})">Ver detalles</button>
    </div>
    <div class="pc-info">
      <p class="pc-name" onclick="openProd(${p.id})">${p.name}</p>
      <p class="pc-region">${p.region}</p>
      <div class="pc-foot">
        <span class="pc-price">${p.price.toFixed(2).replace('.',',')} €</span>
        <button class="add-btn" onclick="addToCart(${p.id})">+</button>
      </div>
    </div>
  </div>`;
}

