<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nosotros · Campoluz Levante</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<!-- CURSOR -->
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cring"></div>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
  <button class="mob-close" onclick="closeMob()">✕</button>
  <a href="index.html" onclick="closeMob()">Inicio</a>
  <a href="tienda.html" onclick="closeMob()">Tienda</a>
  <a href="catas.html" onclick="closeMob()">Catas</a>
  <a href="nosotros.html" onclick="closeMob()">Nosotros</a>
  <a href="ubicacion.html" onclick="closeMob()">Ubicación</a>
  <a href="contacto.html" onclick="closeMob()" style="color:var(--amber)">Profesionales</a>
</div>

<!-- NAV -->
<nav id="nav">
  <a href="index.html" class="nav-logo">Campoluz <span>·</span> Levante</a>
  <ul class="nav-links">
    <li><a href="tienda.html">Tienda</a></li>
    <li><a href="catas.html">Catas</a></li>
    <li><a href="nosotros.html" style="color:var(--amber)">Nosotros</a></li>
    <li><a href="ubicacion.html">Ubicación</a></li>
  </ul>
  <div class="nav-right">
    <button class="cart-btn" onclick="toggleCart()">🛒<span class="cart-count" id="cartCount">0</span></button>
    <a href="contacto.html" class="nav-cta">Profesionales</a>
    <button class="nav-toggle" onclick="toggleMob()" id="navTog"><span></span><span></span><span></span></button>
  </div>
</nav>


<!-- ═══ NOSOTROS ═══ -->
<section class="nosotros" id="nosotros" style="padding-top:10rem">
  <div class="nosotros-img reveal">
    <img src="https://images.unsplash.com/photo-1516594915697-87eb3b1c14ea?w=800&q=80" alt="Viñedo atardecer" loading="lazy">
    <span class="nosotros-img-label">Desde 1999 · Valencia</span>
  </div>
  <div class="nosotros-text reveal">
    <p class="s-tag">Quiénes somos</p>
    <h2 class="s-title">Más de <em>25 años</em><br>eligiendo lo mejor</h2>
    <p class="s-sub">Nacimos en Valencia con una idea simple: acercar los mejores vinos y destilados del mundo a quienes aprecian la calidad y la autenticidad. Hoy somos el distribuidor de referencia para restaurantes, hoteles y particulares de toda España.</p>
    <p class="s-sub" style="margin-top:1rem">Cada referencia de nuestro catálogo ha pasado por la cata de nuestro equipo de sumilleres, garantizando que solo lo excepcional llega a su mesa.</p>
    <div class="nos-nums">
      <div class="nos-num-item"><div class="nos-n">+25</div><div class="nos-l">Años distribuyendo</div></div>
      <div class="nos-num-item"><div class="nos-n">5K+</div><div class="nos-l">Referencias disponibles</div></div>
      <div class="nos-num-item"><div class="nos-n">12</div><div class="nos-l">Países de origen</div></div>
      <div class="nos-num-item"><div class="nos-n">24h</div><div class="nos-l">Entrega express</div></div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="f-logo">Campoluz <span>·</span> Levante</div>
  <p class="f-copy">© 2025 Campoluz Levante S.L. · Paterna, Valencia · Prohibida la venta a menores de 18 años</p>
  <ul class="f-links"><li><a href="#">Privacidad</a></li><li><a href="#">Legal</a></li><li><a href="#">Cookies</a></li></ul>
</footer>

<!-- PRODUCT MODAL -->
<div class="pm-overlay" id="pmOverlay" onclick="closePM(event)">
  <div class="pm-box">
    <div class="pm-img-side">
      <button class="pm-close" onclick="closePMBtn()">✕</button>
      <img id="pmImg" src="" alt="">
    </div>
    <div class="pm-info">
      <span class="pm-badge" id="pmBadge"></span>
      <h2 class="pm-name" id="pmName"></h2>
      <p class="pm-region" id="pmRegion"></p>
      <div class="pm-price-row"><span class="pm-price" id="pmPrice"></span><span class="pm-price-note">/ botella · IVA no incluido</span></div>
      <div class="pm-div"></div>
      <div class="pm-dets" id="pmDets"></div>
      <p class="pm-desc-text" id="pmDesc"></p>
      <div class="pm-qty-row">
        <div class="qty-ctrl">
          <button class="qty-btn" onclick="chgQty(-1)">−</button>
          <span class="qty-val" id="mqty">1</span>
          <button class="qty-btn" onclick="chgQty(1)">+</button>
        </div>
        <button class="pm-add-btn" onclick="addFromModal()">Añadir al carrito</button>
      </div>
    </div>
  </div>
</div>

<!-- CART DRAWER -->
<div class="cart-overlay" id="cartOvl" onclick="toggleCart()"></div>
<div class="cart-drawer" id="cartDrw">
  <div class="cart-hdr"><h2 class="cart-title">Tu carrito</h2><button class="cart-cls" onclick="toggleCart()">✕</button></div>
  <div class="cart-body" id="cartBody"></div>
  <div class="cart-ftr">
    <div class="cart-sub"><span class="cart-sub-lbl">Subtotal</span><span class="cart-sub-val" id="cartTotal">0,00 €</span></div>
    <button class="cart-checkout">Finalizar pedido →</button>
    <button class="cart-cont" onclick="toggleCart()">Seguir comprando</button>
    <p class="cart-note-txt">Envío gratuito a partir de 150 € · IVA no incluido</p>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<script src="site.js"></script>
</body>
</html>
